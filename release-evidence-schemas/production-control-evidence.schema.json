{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structurax.example/release-evidence/production-control-evidence.schema.json",
  "title": "StructuraX Production Control Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "statement", "signature"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewed_repository_sha256",
        "environment_id",
        "completed_at",
        "production_environment_confirmed",
        "raw_endpoint_metadata_present",
        "raw_secret_material_present",
        "controls"
      ],
      "properties": {
        "reviewed_repository_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "environment_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
        "completed_at": {"type": "string", "format": "date-time"},
        "production_environment_confirmed": {"const": true},
        "raw_endpoint_metadata_present": {"const": false},
        "raw_secret_material_present": {"const": false},
        "controls": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "control_id",
              "evidence_kind",
              "result",
              "validator_id",
              "evidence_sha256",
              "completed_at",
              "negative_path_tested"
            ],
            "properties": {
              "control_id": {
                "enum": [
                  "postgresql_tenant_isolation_validated",
                  "external_identity_boundary_validated",
                  "evidence_encryption_and_key_management_validated",
                  "observability_and_deployment_controls_validated"
                ]
              },
              "evidence_kind": {"type": "string", "minLength": 8, "maxLength": 96},
              "result": {"const": "passed"},
              "validator_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,159}$"},
              "evidence_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "completed_at": {"type": "string", "format": "date-time"},
              "negative_path_tested": {"const": true}
            }
          }
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "signature_b64"],
      "properties": {
        "algorithm": {"const": "Ed25519"},
        "key_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "signature_b64": {"type": "string", "minLength": 80, "maxLength": 120}
      }
    }
  }
}
