{
  "policy_version": "1.0-rc1",
  "schema_path": "release-evidence-schemas/independent-security-review-evidence.schema.json",
  "required_schema_version": "1.0.0",
  "release_surface_digest_algorithm": "sha256-release-surface-v1",
  "evidence_envelope_path": "security-review/v1.0-review.json",
  "external_report_required": true,
  "external_report_must_remain_outside_repository": true,
  "required_review_areas": [
    "application_trust_boundaries",
    "cryptography_and_evidence_integrity",
    "dependency_and_supply_chain",
    "deployment_and_observability",
    "identity_and_authorization",
    "ingestion_and_untrusted_content",
    "release_governance",
    "tenant_isolation",
    "workflow_authority_and_audit"
  ],
  "require_passed_outcome": true,
  "max_open_critical_findings": 0,
  "max_open_high_findings": 0,
  "max_open_release_blocking_findings": 0,
  "risk_acceptance_required": false,
  "allow_raw_secret_material": false,
  "reviewer_must_be_independent": true,
  "automatic_gate_mutation_allowed": false,
  "production_readiness_claimed": false
}
