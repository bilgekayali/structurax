    "full_test_suite_passed",
    "promotion_readiness_passed_at_1_0_0",
    "release_evidence_attested_for_exact_commit",
    "human_release_approval_recorded"
  ],
  "automatic_metadata_mutation_allowed": false,
  "automatic_tag_creation_allowed": false,
  "automatic_publish_allowed": false,
  "human_approval_required": true,
  "production_readiness_claimed": false
}
