{
  "$defs": {
    "AIPageInput": {
      "additionalProperties": false,
      "properties": {
        "page_number": {
          "maximum": 200,
          "minimum": 1,
          "title": "Page Number",
          "type": "integer"
        },
        "text": {
          "maxLength": 10000,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "page_number",
        "text"
      ],
      "title": "AIPageInput",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "ingestion_extraction_sha256": {
      "pattern": "^[a-f0-9]{64}$",
