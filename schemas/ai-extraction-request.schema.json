      "type": "string"
    },
    "pages": {
      "items": {
        "$ref": "#/$defs/AIPageInput"
      },
      "maxItems": 200,
      "minItems": 1,
      "title": "Pages",
      "type": "array"
    },
    "requested_fields": {
      "items": {
        "type": "string"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Requested Fields",
      "type": "array"
    },
    "schema_version": {
      "const": "0.3.0",
      "default": "0.3.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Sha256",
      "type": "string"
    }
  },
  "required": [
    "source_sha256",
    "ingestion_extraction_sha256",
    "pages",
    "requested_fields"
