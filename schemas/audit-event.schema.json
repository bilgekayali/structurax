{
  "$defs": {
    "ActorIdentity": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._@-]{2,119}$",
          "title": "Actor Id",
          "type": "string"
        },
        "roles": {
          "items": {
            "$ref": "#/$defs/ReviewRole"
          },
          "maxItems": 6,
          "minItems": 1,
          "title": "Roles",
          "type": "array"
        }
      },
      "required": [
        "actor_id",
        "roles"
      ],
      "title": "ActorIdentity",
      "type": "object"
    },
    "ReviewAction": {
      "enum": [
        "submit",
        "start_review",
        "request_changes",
        "approve",
        "reject",
        "cancel"
      ],
      "title": "ReviewAction",
      "type": "string"
    },
    "ReviewRole": {
      "enum": [
        "requester",
        "reviewer",
        "approver",
        "security",
        "privacy",
        "release_manager"
      ],
      "title": "ReviewRole",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action": {
      "$ref": "#/$defs/ReviewAction"
    },
    "actor": {
      "$ref": "#/$defs/ActorIdentity"
    },
    "case_id": {
      "pattern": "^[A-Z0-9][A-Z0-9._-]{2,79}$",
      "title": "Case Id",
      "type": "string"
    },
    "event_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Event Sha256",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "operational_side_effects_performed": {
      "const": false,
      "default": false,
      "title": "Operational Side Effects Performed",
      "type": "boolean"
    },
    "payload_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Payload Sha256",
      "type": "string"
    },
    "policy_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Policy Sha256",
      "type": "string"
    },
    "prior_event_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prior Event Sha256"
    },
    "raw_document_content_recorded": {
      "const": false,
      "default": false,
      "title": "Raw Document Content Recorded",
      "type": "boolean"
    },
    "schema_version": {
      "const": "0.4.0",
      "default": "0.4.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    }
  },
  "required": [
    "case_id",
    "sequence",
    "action",
    "actor",
    "policy_sha256",
    "occurred_at",
    "payload_sha256",
    "event_sha256"
  ],
  "title": "AuditEvent",
  "type": "object"
}
