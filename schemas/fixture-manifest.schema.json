{
  "$defs": {
    "FixtureEntry": {
      "additionalProperties": false,
      "properties": {
        "expected_outcome": {
          "enum": [
            "accept",
            "reject"
          ],
          "title": "Expected Outcome",
          "type": "string"
        },
        "expected_reason": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Reason"
        },
        "media_type": {
          "enum": [
            "application/pdf",
            "application/json"
          ],
          "title": "Media Type",
          "type": "string"
        },
        "path": {
          "pattern": "^datasets/ingestion/[a-zA-Z0-9._/-]+$",
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256",
        "media_type",
        "expected_outcome"
      ],
      "title": "FixtureEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "entries": {
      "items": {
        "$ref": "#/$defs/FixtureEntry"
      },
      "minItems": 1,
      "title": "Entries",
      "type": "array"
    },
    "fixture_set_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,79}$",
      "title": "Fixture Set Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.2.0",
      "default": "0.2.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "fixture_set_id",
    "entries"
  ],
  "title": "FixtureManifest",
  "type": "object"
}
